# ─── Required API Keys ─────────────────────────────────────────────
Agent_phone_key=
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
Agent_mail_S25=
SUPERMEMORY_API_KEY=
Stripe_secret_key=
Stripe_publishable_key=
GEMINI_API_KEY=

# ─── Tunnel URL ────────────────────────────────────────────────────
# Set this to your public HTTPS tunnel URL (ngrok, localtunnel, etc.)
# AgentPhone uses this to reach your /webhook/voice endpoint
WEBHOOK_URL=

# ─── AgentPhone From-Number ────────────────────────────────────────
# Your AgentPhone voice-capable number in E.164 format (e.g. +12025551234)
# Get it from: agentphone.ai/dashboard → Phone Numbers → pick a voice number
# If left blank, the backend auto-selects the first voice-capable number on your account
AGENTPHONE_FROM_NUMBER=
